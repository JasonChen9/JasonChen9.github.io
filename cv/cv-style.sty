\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{cv-style}[2026/11/03 Shared academic CV style]

\newif\ifcvChinese
\DeclareOption{chinese}{\cvChinesetrue}
\ProcessOptions\relax

\RequirePackage[a4paper,left=16mm,right=16mm,top=14mm,bottom=16mm]{geometry}
\RequirePackage{fontspec}
% TeX-distributed, embeddable fonts make both files portable across platforms.
\setmainfont{texgyreheros-regular.otf}[
  BoldFont=texgyreheros-bold.otf,
  ItalicFont=texgyreheros-italic.otf,
  BoldItalicFont=texgyreheros-bolditalic.otf]
\ifcvChinese
  \RequirePackage{xeCJK}
  \setCJKmainfont{FandolHei-Regular.otf}[BoldFont=FandolHei-Bold.otf]
  \xeCJKsetup{CJKecglue={\hskip 0.08em}}
\fi
\RequirePackage{xcolor}
\RequirePackage{graphicx}
\RequirePackage{tabularx}
\RequirePackage{needspace}
\RequirePackage{fancyhdr}
\RequirePackage{hyperref}
\definecolor{cvaccent}{HTML}{1F4E79}
\definecolor{cvtext}{HTML}{222222}
\definecolor{cvmuted}{HTML}{555555}
\hypersetup{colorlinks=true,urlcolor=cvaccent,linkcolor=cvaccent,
  pdfauthor={Guangyu Xiang},pdfsubject={Academic curriculum vitae},
  pdflang={en-US},pdfdisplaydoctitle=true}
\ifcvChinese
  \hypersetup{pdftitle={向广宇 - 学术简历},pdflang={zh-CN}}
\else
  \hypersetup{pdftitle={Guangyu Xiang - Curriculum Vitae}}
\fi

\setlength{\parindent}{0pt}
\setlength{\parskip}{0pt}
\setlength{\tabcolsep}{0pt}
\setlength{\emergencystretch}{2em}
\raggedright
\color{cvtext}
\AtBeginDocument{\fontsize{10}{13.2}\selectfont}

\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0.3pt}
\fancyfoot[L]{\fontsize{8}{10}\selectfont\color{cvmuted}Guangyu Xiang}
\fancyfoot[C]{\fontsize{8}{10}\selectfont\color{cvmuted}\ifcvChinese 更新于\else Updated\fi\ 2026-11-05}
\fancyfoot[R]{\fontsize{8}{10}\selectfont\color{cvmuted}\thepage}
\setlength{\footskip}{8mm}

\newcommand{\cvheader}[3]{%
  \begin{minipage}[t]{\dimexpr\linewidth-30mm\relax}
  \vspace{0pt}
  {\fontsize{25}{29}\selectfont\bfseries #1}\par
  \vspace{4pt}
  {\fontsize{10.5}{14}\selectfont #2}\par
  \vspace{4pt}
  {\fontsize{9}{12}\selectfont
    \href{mailto:gxiang190@connect.hkust-gz.edu.cn}{gxiang190@connect.hkust-gz.edu.cn}
    \quad | \quad \href{https://jasonchen9.github.io/}{jasonchen9.github.io}}\par
  \vspace{5pt}
  {\fontsize{9.5}{12.5}\selectfont\color{cvmuted}#3}\par
  \end{minipage}\hfill
  \begin{minipage}[t]{22mm}
    \vspace{0pt}
    \raggedleft
    \includegraphics[width=22mm,height=27mm,keepaspectratio]{assets/photo.jpg}
  \end{minipage}\par
  \vspace{4pt}
}

\newcommand{\cvsection}[1]{%
  \Needspace{5\baselineskip}
  \vspace{9pt}
  {\fontsize{12}{15}\selectfont\bfseries\color{cvaccent}#1}\par
  \vspace{2pt}
  {\color{cvaccent}\hrule height 0.6pt}
  \vspace{6pt}
}

\newcommand{\cventry}[4]{%
  \Needspace{6\baselineskip}
  \begin{tabularx}{\linewidth}{@{}>{\raggedright\arraybackslash}X@{\hspace{10pt}}r@{}}
    {\bfseries #1} & {\fontsize{9}{12}\selectfont\color{cvmuted}#2}
  \end{tabularx}\par
  {\fontsize{9.5}{12.5}\selectfont\color{cvmuted}#3}\par
  \vspace{2pt}
  {\fontsize{9.5}{12.7}\selectfont #4}\par
  \vspace{7pt}
}

\newcommand{\cvpublication}[4]{%
  \Needspace{7\baselineskip}
  {\fontsize{10}{12.7}\selectfont\bfseries\href{#4}{\color{cvtext}#1}}\par
  \vspace{2pt}
  {\fontsize{8.5}{11}\selectfont\color{cvmuted}#2}\par
  \vspace{2pt}
  {\fontsize{9.5}{12.3}\selectfont\color{cvaccent}#3}\par
  \vspace{8pt}
}

\newcommand{\cvnote}[1]{{\fontsize{8.5}{11}\selectfont\color{cvmuted}#1}\par\vspace{5pt}}
\newcommand{\cvproject}[2]{%
  \Needspace{5\baselineskip}
  {\bfseries #1}\par\vspace{2pt}
  {\fontsize{9.5}{12.7}\selectfont #2}\par\vspace{7pt}
}
\newcommand{\cvskill}[2]{%
  {\fontsize{9.5}{13}\selectfont\textbf{#1}\quad #2}\par\vspace{3pt}
}
\newcommand{\cvhonor}[1]{%
  {\fontsize{9.5}{13}\selectfont\textbullet\ \ #1}\par\vspace{3pt}
}
