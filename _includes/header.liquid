{% assign current_lang = page.lang | default: site.lang %}
{% assign home_path = '/' %}
{% assign about_title = 'about' %}
{% if current_lang == 'zh-CN' %}
  {% assign home_path = '/zh/' %}
  {% assign about_title = '关于' %}
{% endif %}
{% for p in site.pages %}
  {% if p.translation_key == 'about' and p.lang == current_lang %}
    {% assign home_path = p.permalink %}
    {% assign about_title = p.title %}
  {% endif %}
{% endfor %}

<header>
  <!-- Nav Bar -->
  <nav id="navbar" class="navbar navbar-light navbar-expand-sm {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}" role="navigation">
    <div class="container">
      {% if page.permalink != home_path %}
        <a class="navbar-brand title font-weight-lighter" href="{{ home_path | relative_url }}">
          {% if site.title == 'blank' %}
            {% if site.first_name %}
              <span class="font-weight-bold">{{- site.first_name -}}</span>
            {% endif %}
            {% if site.middle_name %}{{- site.middle_name -}}{% endif %}
            {% if site.last_name %}{{- site.last_name -}}{% endif %}
          {% else %}
            {{- site.title -}}
          {% endif %}
        </a>
      {% elsif site.enable_navbar_social %}
        <div class="navbar-brand social">{% social_links %}</div>
      {% endif %}

      <button
        class="navbar-toggler collapsed navbar-toggler-main"
        type="button"
        data-nav-toggle="navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="{% if current_lang == 'zh-CN' %}展开导航{% else %}Toggle navigation{% endif %}"
      >
        <span class="sr-only">
          {%- if current_lang == 'zh-CN' %}展开导航{% else %}Toggle navigation{% endif -%}
        </span>
        <span class="icon-bar top-bar"></span>
        <span class="icon-bar middle-bar"></span>
        <span class="icon-bar bottom-bar"></span>
      </button>

      <div class="collapse navbar-collapse navbar-collapse-main" id="navbarNav">
        <ul class="navbar-nav navbar-menu-list flex-nowrap">
          <li class="nav-item {% if page.translation_key == 'about' %}active{% endif %}">
            <a class="nav-link" href="{{ home_path | relative_url }}">
              {{- about_title -}}
              {% if page.translation_key == 'about' -%}
                <span class="sr-only">
                  {%- if current_lang == 'zh-CN' %}（当前页面）{% else %}(current){% endif -%}
                </span>
              {%- endif %}
            </a>
          </li>

          {% assign sorted_pages = site.pages | sort: 'nav_order' %}
          {% for p in sorted_pages %}
            {% assign p_lang = p.lang | default: site.lang %}
            {% if p.nav and p.autogen == null and p_lang == current_lang %}
              {% assign is_active = false %}
              {% if page.translation_key and page.translation_key == p.translation_key %}
                {% assign is_active = true %}
              {% elsif page.url contains p.url %}
                {% assign is_active = true %}
              {% endif %}

              {% if p.dropdown %}
                {% assign has_active_child = false %}
                {% for child in p.children %}
                  {% if page.title == child.title %}{% assign has_active_child = true %}{% endif %}
                {% endfor %}
                <li class="nav-item dropdown {% if is_active or has_active_child %}active{% endif %}">
                  <a
                    class="nav-link dropdown-toggle"
                    href="#"
                    id="navbarDropdown"
                    role="button"
                    data-nav-dropdown-toggle="true"
                    aria-haspopup="true"
                    aria-expanded="false"
                  >
                    {{- p.title -}}
                    {% if is_active or has_active_child -%}
                      <span class="sr-only">
                        {%- if current_lang == 'zh-CN' %}（当前页面）{% else %}(current){% endif -%}
                      </span>
                    {%- endif %}
                  </a>
                  <div class="dropdown-menu dropdown-menu-right" aria-labelledby="navbarDropdown">
                    {% for child in p.children %}
                      {% if child.title == 'divider' %}
                        <div class="dropdown-divider"></div>
                      {% else %}
                        <a
                          class="dropdown-item {% if page.title == child.title %}active{% endif %}"
                          href="{% if child.permalink contains '://' %}{{ child.permalink }}{% else %}{{ child.permalink | relative_url }}{% endif %}"
                        >
                          {{- child.title -}}
                        </a>
                      {% endif %}
                    {% endfor %}
                  </div>
                </li>
              {% else %}
                {% if p.permalink contains '://' %}
                  {% assign page_url = p.permalink %}
                {% elsif p.permalink contains '/blog/' %}
                  {% assign page_url = '/blog/' %}
                {% else %}
                  {% assign page_url = p.url %}
                {% endif %}
                <li class="nav-item {% if is_active %}active{% endif %}">
                  <a class="nav-link" href="{{ page_url | relative_url }}">
                    {{- p.title -}}
                    {% if is_active -%}
                      <span class="sr-only">
                        {%- if current_lang == 'zh-CN' %}（当前页面）{% else %}(current){% endif -%}
                      </span>
                    {%- endif %}
                  </a>
                </li>
              {% endif %}
            {% endif %}
          {% endfor %}

          {% if page.translation_url %}
            {% if current_lang == 'zh-CN' %}
              {% assign language_label = 'EN' %}
              {% assign language_code = 'en' %}
              {% assign language_aria = '切换到英文' %}
            {% else %}
              {% assign language_label = '中文' %}
              {% assign language_code = 'zh-CN' %}
              {% assign language_aria = '切换到中文' %}
            {% endif %}
            <li class="nav-item language-switch">
              <a
                class="nav-link"
                href="{{ page.translation_url | relative_url }}"
                lang="{{ language_code }}"
                hreflang="{{ language_code }}"
                aria-label="{{ language_aria }}"
              >
                {{- language_label -}}
              </a>
            </li>
          {% endif %}

          {% if site.search_enabled %}
            <li class="nav-item">
              <button
                id="search-toggle"
                type="button"
                title="{% if current_lang == 'zh-CN' %}搜索{% else %}Search{% endif %}"
                aria-label="{% if current_lang == 'zh-CN' %}打开搜索{% else %}Open search{% endif %}"
              >
                <span class="nav-link">ctrl k <i class="fa-solid fa-magnifying-glass"></i></span>
              </button>
            </li>
          {% endif %}
          {% if site.enable_darkmode %}
            <li class="toggle-container">
              <button
                id="light-toggle"
                type="button"
                title="{% if current_lang == 'zh-CN' %}切换主题{% else %}Change theme{% endif %}"
                aria-label="{% if current_lang == 'zh-CN' %}切换颜色主题{% else %}Change color theme{% endif %}"
              >
                <i class="fa-half-sun-moon" id="light-toggle-system"></i>
                <i class="fa-solid fa-moon" id="light-toggle-dark"></i>
                <i class="fa-solid fa-sun" id="light-toggle-light"></i>
              </button>
            </li>
          {% endif %}
        </ul>
      </div>
    </div>
  </nav>
  {% if site.enable_progressbar %}
    <progress id="progress" value="0">
      <div class="progress-container"><span class="progress-bar"></span></div>
    </progress>
  {% endif %}
</header>
